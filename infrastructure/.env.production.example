# Production template for Coolify.
# Replace every CHANGE_ME value in Coolify's secret store, never in Git.

# PostgreSQL (internal only)
POSTGRES_USER=dental_admin_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=dental_automation_db
POSTGRES_PORT=5432

# n8n: replace the example host with the exact HTTPS FQDN assigned in Coolify.
N8N_VERSION=2.30.5
N8N_PORT=5678
N8N_HOST=n8n.example.invalid
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.example.invalid/
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_ENCRYPTION_KEY
N8N_SECURE_COOKIE=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_EXTERNAL=axios,moment,lodash
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=America/Hermosillo
WEBHOOK_URL=https://n8n.example.invalid/

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_SYSTEM_USER_PERMANENT_TOKEN=CHANGE_ME

# Telegram (also create/reassign the credential inside n8n)
TELEGRAM_BOT_TOKEN=CHANGE_ME

# LLM providers
DEEPSEEK_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME

# Cal.com
CAL_API_KEY=CHANGE_ME
CALCOM_API_KEY=CHANGE_ME
CAL_EVENT_TYPE_ID=CHANGE_ME

# Email notifications
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
ADMIN_EMAIL=admin@smilestudio.example
