# ===================================================================
# DENTAL CLINIC AUTOMATION — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL 16)
POSTGRES_USER=dental_admin_prod
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_VERY_SECURE_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=dental_automation_db
POSTGRES_PORT=5432

# 2. N8N ORCHESTRATOR CONFIGURATION
N8N_PORT=5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
NODE_FUNCTION_ALLOW_EXTERNAL=axios,moment,lodash
GENERIC_TIMEZONE=America/Mexico_City
WEBHOOK_URL=https://n8n.tudominio.com/

# 3. META WHATSAPP CLOUD API (PRODUCTION LIVE)
WHATSAPP_VERIFY_TOKEN=YOUR_CUSTOM_SECURE_WEBHOOK_VERIFY_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_BUSINESS_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_META_WABA_ID
WHATSAPP_SYSTEM_USER_PERMANENT_TOKEN=EAAG...YOUR_PERMANENT_META_TOKEN

# 4. AI & INTEGRATIONS (GEMINI & CAL.COM)
GEMINI_API_KEY=AIzaSy...YOUR_PRODUCTION_GOOGLE_AI_STUDIO_API_KEY
CAL_API_KEY=cal_live_...YOUR_CALCOM_API_KEY
CAL_EVENT_TYPE_ID=123456
