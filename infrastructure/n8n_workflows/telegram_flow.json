{
  "id": "telegram-llm-flow-01",
  "name": "Telegram - LLM Assistant (Dental Clinic)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "tg-1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials-id",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "channel",
              "value": "telegram"
            },
            {
              "name": "channelUserId",
              "value": "=tg_{{ $json.message.from.id }}"
            },
            {
              "name": "userName",
              "value": "={{ $json.message.from.first_name || 'Paciente' }}"
            },
            {
              "name": "messageText",
              "value": "={{ $json.message.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "tg-norm",
      "name": "Normalize Input (Telegram)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "core-engine-flow-01"
      },
      "id": "tg-core",
      "name": "Call Core Engine",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.botResponse }}",
        "additionalFields": {}
      },
      "id": "tg-send",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        850,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials-id",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Normalize Input (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input (Telegram)": {
      "main": [
        [
          {
            "node": "Call Core Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Core Engine": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}