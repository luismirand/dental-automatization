---
import { ShieldCheck, Calendar, Sparkles, MessageCircle, Star, Clock, CheckCircle2 } from '@lucide/astro';
---

<section id="inicio" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-teal-50/50 via-slate-50 to-white">
  
  <!-- Subtle Background Decorative Blurs -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-tr from-teal-200/30 via-cyan-200/20 to-transparent blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-100/70 border border-teal-200/80 text-teal-800 text-xs font-semibold tracking-wide">
          <Sparkles class="w-4 h-4 text-teal-600" />
          <span>Odontología de Vanguardia & Atención 24/7 con IA</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Tu sonrisa perfecta en manos de <span class="bg-gradient-to-r from-teal-600 via-cyan-600 to-teal-800 bg-clip-text text-transparent">especialistas de confianza</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Agenda tu valoración odontológica en tiempo real en menos de 1 minuto. Puedes elegir tu horario preferido en nuestro calendario digital o chatear directamente con nuestro asistente inteligente de WhatsApp.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 max-w-xl mx-auto lg:mx-0 text-left">
          <div class="flex items-center gap-2 text-slate-700 text-sm font-medium">
            <CheckCircle2 class="w-4 h-4 text-teal-600 flex-shrink-0" />
            <span>Sin tiempos de espera</span>
          </div>
          <div class="flex items-center gap-2 text-slate-700 text-sm font-medium">
            <CheckCircle2 class="w-4 h-4 text-teal-600 flex-shrink-0" />
            <span>Confirmación al instante</span>
          </div>
          <div class="flex items-center gap-2 text-slate-700 text-sm font-medium">
            <CheckCircle2 class="w-4 h-4 text-teal-600 flex-shrink-0" />
            <span>Atención WhatsApp 24/7</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
          <button
            data-cal-link="luismira"
            data-cal-config='{"layout":"month_view"}'
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-xl shadow-teal-600/30 hover:shadow-teal-600/45 transition-all duration-300 cursor-pointer active:scale-98"
          >
            <Calendar class="w-5 h-5" />
            <span>Agendar Cita en Línea</span>
          </button>

          <a
            href="https://wa.me/5210000000000?text=Hola,%20quisiera%20agendar%20una%20cita%20dental"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-white hover:bg-emerald-50 text-slate-800 font-semibold text-base px-7 py-4 rounded-2xl border border-slate-200 hover:border-emerald-300 shadow-sm hover:shadow transition-all duration-300"
          >
            <MessageCircle class="w-5 h-5 text-emerald-600" />
            <span>Agendar por WhatsApp</span>
          </a>
        </div>

        <!-- Social Proof Stats -->
        <div class="pt-6 border-t border-slate-200/60 flex items-center justify-center lg:justify-start gap-8">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              <span class="inline-block w-8 h-8 rounded-full ring-2 ring-white bg-teal-500 text-white text-xs font-bold flex items-center justify-center">DR</span>
              <span class="inline-block w-8 h-8 rounded-full ring-2 ring-white bg-cyan-600 text-white text-xs font-bold flex items-center justify-center">MG</span>
              <span class="inline-block w-8 h-8 rounded-full ring-2 ring-white bg-slate-800 text-white text-xs font-bold flex items-center justify-center">AL</span>
            </div>
            <div>
              <div class="flex items-center text-amber-400">
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
                <Star class="w-4 h-4 fill-amber-400" />
              </div>
              <span class="text-xs font-medium text-slate-500">4.9/5 (+1,200 pacientes felices)</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Feature Card & Quick Preview -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-3xl bg-gradient-to-b from-white to-slate-50 p-6 sm:p-8 shadow-2xl border border-slate-100/80">
          
          <div class="flex items-center justify-between pb-6 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold">
                <Clock class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900">Horarios Disponibles</h3>
                <p class="text-xs text-slate-500">Actualizados en tiempo real</p>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">En Línea</span>
          </div>

          <!-- Feature Specs -->
          <div class="py-6 space-y-4">
            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-teal-50/60 border border-teal-100/70">
              <ShieldCheck class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold text-teal-950 uppercase tracking-wider">Valoración Inicial Completa</h4>
                <p class="text-xs text-slate-600 mt-0.5">Incluye diagnóstico clínico digital y plan de tratamiento personalizado.</p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-cyan-50/60 border border-cyan-100/70">
              <MessageCircle class="w-5 h-5 text-cyan-600 flex-shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold text-cyan-950 uppercase tracking-wider">Asistente IA por WhatsApp</h4>
                <p class="text-xs text-slate-600 mt-0.5">Resuelve tus dudas sobre precios, servicios y reagenda tu cita 24/7.</p>
              </div>
            </div>
          </div>

          <!-- Quick Interactive Embed Trigger Box -->
          <div class="pt-4 border-t border-slate-100 text-center">
            <a href="#agendar" class="inline-flex items-center gap-2 text-xs font-bold text-teal-700 hover:text-teal-900 transition-colors">
              <span>Ver calendario completo abajo</span>
              <span class="text-base">↓</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
