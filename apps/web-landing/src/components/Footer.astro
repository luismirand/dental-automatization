---
import { Smile, Phone, MapPin, Mail, Clock } from '@lucide/astro';
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Col 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-600 flex items-center justify-center text-white">
            <Smile class="w-5 h-5" />
          </div>
          <span class="text-lg font-bold text-white">Sonrisa Real</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Clínica dental especializada en agendamiento inteligente y atención de primera calidad para toda la familia.
        </p>
      </div>

      <!-- Col 2: Servicios -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Especialidades</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#" class="hover:text-teal-400 transition-colors">Ortodoncia Invisible</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Diseño de Sonrisa</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Implantes Dentales</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Limpieza y Blanqueamiento</a></li>
        </ul>
      </div>

      <!-- Col 3: Horarios -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Horarios</h4>
        <div class="space-y-2 text-xs">
          <div class="flex items-center gap-2">
            <Clock class="w-4 h-4 text-teal-500" />
            <span>Lun - Vie: 9:00 AM - 7:00 PM</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock class="w-4 h-4 text-teal-500" />
            <span>Sábados: 9:00 AM - 2:00 PM</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock class="w-4 h-4 text-slate-600" />
            <span class="text-slate-500">Domingos: Cerrado</span>
          </div>
        </div>
      </div>

      <!-- Col 4: Contacto -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Ubicación</h4>
        <div class="space-y-2 text-xs">
          <div class="flex items-start gap-2">
            <MapPin class="w-4 h-4 text-teal-500 flex-shrink-0 mt-0.5" />
            <span>Av. Principal de la Salud #123, Col. Centro</span>
          </div>
          <div class="flex items-center gap-2">
            <Phone class="w-4 h-4 text-teal-500" />
            <span>+52 (55) 1234-5678</span>
          </div>
          <div class="flex items-center gap-2">
            <Mail class="w-4 h-4 text-teal-500" />
            <span>contacto@sonrisareal.com</span>
          </div>
        </div>
      </div>

    </div>

    <div class="pt-8 mt-8 border-t border-slate-900 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Clínica Dental Sonrisa Real. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
